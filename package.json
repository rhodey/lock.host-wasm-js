{
  "name": "lock.host-wasm-js",
  "version": "0.1.0",
  "description": "Lock.host WASM js starter",
  "homepage": "https://lock.host",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git://github.com/rhodey/lock.host-wasm-js.git"
  },
  "scripts": {
    "bundle": "rollup -c",
    "wit": "mkdir -p wit/deps/sqlite && cp node_modules/sqlite-wasm-wasi/dist/wit/sqlite.wit wit/deps/sqlite/",
    "build": "npm run bundle && npm run wit && componentize-js dist/bundle.js --wit wit -o dist/bundle.wasm"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "^0.19.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "rollup": "^4.59.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@solana-program/system": "^0.12.0",
    "@solana/kit": "^6.1.0",
    "bs58": "^6.0.0",
    "itty-router": "^5.0.22",
    "openai": "^6.22.0",
    "sqlite-wasm-wasi": "^0.5.3"
  }
}
